# Configuração de Segurança e Conexão de Banco de Dados (.env.example)
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=insira_aqui_sua_chave_criptografica_de_32_bytes

# URL de Conexão com PostgreSQL 18 + PostGIS
DATABASE_URL=postgresql+psycopg://pga_app:PgaSecure2026%21%40%23@localhost:5432/pga_db

# Parâmetros do Servidor Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
WTF_CSRF_ENABLED=true
